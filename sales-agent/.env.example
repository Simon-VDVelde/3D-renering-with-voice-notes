# ========================================================
# SALES-AGENT CONFIGURATIE (.env.example)
# ========================================================

# 1. SERPER.DEV API KEY (Google Maps & Search Lead Scraper)
SERPER_API_KEY=jouw_serper_api_key_hier

# 2. OPENAI API KEY (AI Copywriting voor gepersonaliseerde B2B e-mails)
OPENAI_API_KEY=jouw_openai_api_key_hier

# 3. BASE DEMO URL (Domein waar gegenereerde 3D demo's bereikbaar zijn)
BASE_DEMO_URL=http://localhost:8080/demo

# ========================================================
# 4. EMAIL OUTREACH: RESEND API
# ========================================================
EMAIL_DISPATCH_ACTION=send
EMAIL_PROVIDER=resend

# Jouw Resend API Key (verkrijgbaar via resend.com/api-keys)
RESEND_API_KEY=re_jouw_resend_api_key_hier

# Afzendergegevens
EMAIL_FROM_NAME="Simon"
EMAIL_FROM_EMAIL=onboarding@resend.dev

# Test ontvanger (laat leeg zodra je eigen domein geverifieerd is op resend.com/domains)
RESEND_TEST_RECIPIENT=simon.vandevelde22@gmail.com

# ========================================================
# 5. OVERIGE PARAMETERS
# ========================================================
OPENAI_MODEL=gpt-4o-mini
DEFAULT_QUERY="machinebouwers Vlaanderen"
DEFAULT_COUNTRY="be"
DEFAULT_LANG="nl"
