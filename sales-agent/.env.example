# ========================================================
# SALES-AGENT CONFIGURATIE (.env)
# ========================================================

# 1. SERPER.DEV API KEY (Google Maps & Search Lead Scraper)
# Maak een gratis account aan op https://serper.dev (2.500 gratis zoekopdrachten)
SERPER_API_KEY=jouw_serper_api_key_hier

# 2. OPENAI API KEY (AI Copywriting voor gepersonaliseerde B2B e-mails)
# Verkrijg je sleutel op https://platform.openai.com/api-keys
OPENAI_API_KEY=jouw_openai_api_key_hier

# 3. BASE DEMO URL (Domein waar gegenereerde 3D demo's bereikbaar zijn)
# Lokaal: http://localhost:8080/demo
# Productie: https://jouwwebsite.be/demo
BASE_DEMO_URL=http://localhost:8080/demo

# ========================================================
# 4. EMAIL OUTREACH: CONCEPTEN IN MAILBOX / VERSTUREN
# ========================================================

# Standaard actie:
#   'draft'   = Klaarzetten als Concept in je mailbox (Aanbevolen! Veilig reviewen voor verzending)
#   'send'    = Direct verzenden naar de prospect
#   'dry-run' = Alleen simuleren en loggen (veilig testen)
#   'none'    = Geen e-mailactie uitvoeren
EMAIL_DISPATCH_ACTION=draft

# Voorkeurs-provider: 'auto', 'imap' (voor drafts), 'smtp', 'resend'
EMAIL_PROVIDER=auto

# Afzendergegevens
EMAIL_FROM_NAME="Simon"
EMAIL_FROM_EMAIL=simon@jouwwebsite.be

# --- OPTIE A: GMAIL / OUTLOOK / EIGEN DOMEIN (IMAP & SMTP) ---
# Tip voor Gmail: Gebruik een Google App Wachtwoord (16 tekens via myaccount.google.com/apppasswords)
EMAIL_USER=
EMAIL_PASS=

# IMAP Server (voor het opslaan als CONCEPT in je mailbox)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=Drafts

# SMTP Server (voor het direct VERSTUREN via je mailbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# --- OPTIE B: RESEND API (voor direct professioneel versturen via API) ---
# Verkrijg je gratis API key op https://resend.com
RESEND_API_KEY=

# ========================================================
# 5. OVERIGE PARAMETERS
# ========================================================
OPENAI_MODEL=gpt-4o-mini
DEFAULT_QUERY="machinebouwers Vlaanderen"
DEFAULT_COUNTRY="be"
DEFAULT_LANG="nl"
