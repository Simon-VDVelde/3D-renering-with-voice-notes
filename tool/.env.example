# ========================================================
# SPATIAL SOP - ENTERPRISE CONFIGURATIE (.env)
# ========================================================

# 1. AI & LLM CONFIGURATIE (Google Gemini / Vertex AI)
# Standaard API sleutel via Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=jouw_api_sleutel_hier

# Optioneel: Enterprise Google Cloud Vertex AI (Data residency binnen EU)
# Haal de '#' weg om Vertex AI te activeren:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=jouw-gcp-project-id
# GOOGLE_CLOUD_LOCATION=europe-west4

# 2. B2B TOEGANGSBEVEILIGING VOOR WEB VIEWER
# Operator-PIN (alleen-lezen, inspecteren, talen, audio, checklist afvinken):
VIEWER_ACCESS_PIN=1234
# Supervisor/Admin-PIN (volledige toegang tot Human-in-the-Loop Web Editor):
VIEWER_ADMIN_PIN=9999

# 3. METADATA & COMPLIANCE (Wordt getoond in SOP Viewer)
SOP_ORGANIZATION="Uw Bedrijfsnaam"
SOP_CONFIDENTIALITY="Intern Vertrouwelijk"

# 4. DEPLOYMENT INSTELLINGEN
# Keuzes: none (alleen lokaal bekijken via npm run preview), cloudflare (automatisch publiceren)
DEPLOY_TARGET=none
CLOUDFLARE_PROJECT=spatial-sop-demo
